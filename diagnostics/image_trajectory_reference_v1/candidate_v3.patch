+    (403,"ASSET_ACCESS_REQUIRED","ASSET_ACCESS_REQUIRED"),
+    (404,"ASSET_ACCESS_REQUIRED","ASSET_ACCESS_REQUIRED"),
+    (429,"RESOLVE_FAILED","ENGINEERING_FAILURE"),
+    (503,"RESOLVE_FAILED","ENGINEERING_FAILURE"),
