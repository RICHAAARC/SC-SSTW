+def replay_worker(store,cfg):
+    import torch
+    from runtime.wan.generation import load_frozen_vae
+    store.data['stage']='VAE_LOAD';store.save()
+    frozen=load_frozen_vae(cfg,device='cuda' if torch.cuda.is_available() else 'cpu')
