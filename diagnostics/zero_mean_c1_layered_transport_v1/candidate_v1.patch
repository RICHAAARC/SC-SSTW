+            qr=store.data['rasters'][arm+'/RGB8_NO_CODEC'];qr.update(save_tensor(qr['path'],q8));del q8;store.save()
+            q8=reopen_tensor(qr);encoded_layer(store,arm,'RGB8_NO_CODEC',q8.float()/255.,frozen,cfg)
