+            if canonical is not None:winner=candidate_terms(obs,mu[np.asarray(catalog[canonical]['taus'])-1])
+            costs=np.asarray(inf['path_costs'],dtype=np.float64)
+            fixed=dict(opponents[arm+'/'+kid])
